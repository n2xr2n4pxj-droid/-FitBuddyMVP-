import { Router } from 'express';
import { db, pool } from '../db';
import { users } from '@shared/schema';
import { eq } from 'drizzle-orm';
import { hashPassword, verifyPassword, isAuthenticated, verifyJWT } from '../replitAuth';
import * as jwt from 'jsonwebtoken';
import { 
  getUserById, 
  getUserByEmail, 
  updateUserRole,
  createUser 
} from '../db/queries';

const router = Router();

/**
 * POST /auth/register
 * 用戶註冊
 */
router.post('/auth/register', verifyJWT, async (req: any, res: any) => {
  try {
    const { email, password, firstName, lastName, role } = req.body;

    console.log('[POST /auth/register]', { email, firstName, lastName });

    // ✅ 驗證輸入
    if (!email || !password) {
      return res.status(400).json({ message: 'Email and password are required' });
    }

    if (password.length < 8) {
      return res.status(400).json({ message: 'Password must be at least 8 characters' });
    }

    // ✅ 使用查詢助手檢查用戶是否已存在
    const existingUser = await getUserByEmail(email);
    if (existingUser) {
      return res.status(409).json({ message: 'Email already registered' });
    }

    // ✅ 加密密碼
    const passwordHash = hashPassword(password);

    // ✅ 驗證並標準化角色
    let normalizedRole: 'coach' | 'client' = 'client';
    if (role) {
      const r = role.toLowerCase();
      if (r === 'coach' || r === 'client') {
        normalizedRole = r as 'coach' | 'client';
      }
    }

    // ✅ 使用查詢助手創建用戶
    const newUser = await createUser({
      email,
      passwordHash,
      firstName,
      lastName,
      role: normalizedRole,
    });

    if (!newUser) {
      console.error('[POST /auth/register] Failed to create user - no user returned');
      return res.status(500).json({ message: 'Failed to create user' });
    }

    console.log('[POST /auth/register] Success:', newUser.id);

    // 標準化角色用於響應
    const normalizeRole = (role?: string | null): 'coach' | 'client' | null => {
      if (!role) return null;
      const r = role.toLowerCase();
      if (r === 'coach') return 'coach';
      if (r === 'client') return 'client';
      return null;
    };

    res.status(201).json({
      id: newUser.id,
      email: newUser.email,
      firstName: newUser.firstName,
      lastName: newUser.lastName,
      role: normalizeRole(newUser.role),
      message: 'Registration successful',
    });
  } catch (error) {
    console.error('[POST /auth/register] Error:', error);
    res.status(500).json({
      message: 'Failed to register user',
      error: error instanceof Error ? error.message : 'Unknown error',
    });
  }
});

/**
 * POST /auth/login
 * 用戶登入
 */
router.post('/auth/login', async (req: any, res: any) => {
  try {
    const { email, password } = req.body;

    console.log('[POST /auth/login]', { email });

    // ✅ 驗證輸入
    if (!email || !password) {
      return res.status(400).json({ message: 'Email and password are required' });
    }

    // ✅ 使用查詢助手獲取用戶
    const user = await getUserByEmail(email);

    if (!user) {
      console.log('[POST /auth/login] User not found:', email);
      return res.status(401).json({ message: 'Invalid credentials' });
    }

    // ✅ 驗證密碼
    if (!user.passwordHash) {
      console.log('[POST /auth/login] User has no password hash:', email);
      return res.status(401).json({ message: 'Invalid credentials' });
    }

    const passwordValid = verifyPassword(password, user.passwordHash);
    if (!passwordValid) {
      console.log('[POST /auth/login] Invalid password for:', email);
      return res.status(401).json({ message: 'Invalid credentials' });
    }

    // ✅ 生成 JWT token
    const token = jwt.sign(
      {
        sub: user.id,
        email: user.email,
        role: user.role,
      },
      process.env.JWT_SECRET || 'dev-jwt-secret-key',
      { expiresIn: '7d' }
    );

    console.log('[POST /auth/login] Success:', user.id);

    // ✅ 去掉敏感信息
    const { passwordHash, ...safeUser } = user as any;

    // 標準化角色
    const normalizeRole = (role?: string | null): 'coach' | 'client' | null => {
      if (!role) return null;
      const r = role.toLowerCase();
      if (r === 'coach') return 'coach';
      if (r === 'client') return 'client';
      return null;
    };

    res.json({
      token,
      user: {
        id: safeUser.id,
        email: safeUser.email,
        firstName: safeUser.firstName,
        lastName: safeUser.lastName,
        role: normalizeRole(safeUser.role),
      },
    });
  } catch (error) {
    console.error('[POST /auth/login] Error:', error);
    res.status(500).json({
      message: 'Failed to login',
      error: error instanceof Error ? error.message : 'Unknown error',
    });
  }
});

// ✅ 角色選擇處理函數（共用邏輯）
const handleRoleSelect = async (req: any, res: any) => {
  try {
    console.log('[SelectRole] ===== START =====');
    console.log('[SelectRole] Request body:', req.body);
    console.log('[SelectRole] req.user:', req.user);

    // ✅ 步驟 1：獲取 userId
    const userId = req.user?.id;
    
    if (!userId) {
      console.log('[SelectRole] ❌ userId is missing');
      return res.status(401).json({ 
        error: 'Not authenticated',
        debug: { hasUser: !!req.user, userId }
      });
    }

    // ✅ 步驟 2：驗證角色
    const { role } = req.body;
    
    if (!role || !['coach', 'client'].includes(role)) {
      console.log('[SelectRole] ❌ Invalid role:', role);
      return res.status(400).json({ 
        error: "Invalid role. Must be 'coach' or 'client'"
      });
    }

    console.log('[SelectRole] ✅ Validation passed', { userId, role });

    // ✅ 步驟 3：使用查詢助手更新數據庫
    const updatedUser = await updateUserRole(userId, role);

    if (!updatedUser) {
      console.log('[SelectRole] ❌ User not found:', userId);
      return res.status(404).json({ error: 'User not found' });
    }

    console.log('[SelectRole] ✅ Database updated:', updatedUser);

    // ✅ 步驟 4：更新 session 用戶對象
    if (req.user) {
      req.user.role = role;
    }

    // ✅ 步驟 5：返回成功響應
    const response = {
      success: true,
      message: 'Role selected successfully',
      role,
      user: {
        id: updatedUser.id,
        email: updatedUser.email,
        firstName: updatedUser.firstName,
        lastName: updatedUser.lastName,
        role: updatedUser.role,
        createdAt: updatedUser.createdAt,
        updatedAt: updatedUser.updatedAt
      }
    };

    console.log('[SelectRole] ✅ SUCCESS:', response);
    console.log('[SelectRole] ===== END =====');

    return res.status(200).json(response);

  } catch (error) {
    console.error('[SelectRole] ❌ ERROR:', error);
    return res.status(500).json({
      error: 'Failed to select role',
      message: error instanceof Error ? error.message : String(error)
    });
  }
};

// ✅ SELECT ROLE 端點 - 改用 verifyJWT 支持 Bearer Token
// 支持兩個路徑：/api/auth/role-select 和 /api/auth/select-role
router.post('/auth/role-select', verifyJWT, handleRoleSelect);
router.post('/auth/select-role', verifyJWT, handleRoleSelect);

// ✅ 獲取當前用戶信息（包括 role）
router.get('/auth/me', async (req: any, res: any) => {
  try {
    const token = req.headers.authorization?.split(' ')[1];

    if (!token) {
      return res.status(401).json({ error: 'Not authenticated' });
    }

    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'dev-jwt-secret-key') as any;
    const userId = decoded.sub;

    if (!userId) {
      return res.status(401).json({ error: 'Not authenticated' });
    }

    // 使用查詢助手獲取用戶
    const user = await getUserById(userId);

    if (!user) {
      return res.status(404).json({ error: 'User not found' });
    }

    // 移除敏感信息
    const { passwordHash, ...safeUser } = user as any;

    // 將資料庫中的角色標準化為前端期望格式
    const normalizeRole = (role?: string | null): 'coach' | 'client' | null => {
      if (!role) return null;
      const r = role.toLowerCase();
      if (r === 'coach') return 'coach';
      if (r === 'client') return 'client';
      return null;
    };

    res.json({
      id: safeUser.id,
      email: safeUser.email,
      firstName: safeUser.firstName,
      lastName: safeUser.lastName,
      role: normalizeRole(safeUser.role),
    });
  } catch (error) {
    console.error('Error fetching user:', error);
    res.status(500).json({ error: 'Failed to fetch user' });
  }
});

// ✅ 登出端點
router.post('/auth/logout', async (req: any, res: any) => {
  try {
    const token = req.headers.authorization?.split(' ')[1];

    if (!token) {
      return res.status(401).json({ error: 'Not authenticated' });
    }

    // JWT 是無狀態的，所以登出主要是客戶端清除 token
    res.json({ success: true, message: 'Logged out successfully' });
  } catch (error) {
    console.error('Error logging out:', error);
    res.status(500).json({ error: 'Failed to logout' });
  }
});

export default router;
