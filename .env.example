# ==========================================
# FitBuddy 環境變量配置範本
# ==========================================
# 
# 使用說明：
# 1. 複製此文件到 server/.env.local（後端配置）
# 2. 複製前端變量部分到 client/.env.local（前端配置）
# 3. 填入真實的配置值
# 4. 不要提交 .env.local 文件到 Git
#
# 注意：
# - 前端變量必須以 VITE_ 開頭（Vite 要求）
# - 後端變量不要使用 VITE_ 前綴
# - 生產環境必須設置所有標記為 [必需] 的變量
# ==========================================

# ========== 應用基本配置 ==========
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# ========== 數據庫配置 ==========
# [必需] 數據庫連接字符串
# Neon：連線字串應含 sslmode=require（後端對非本機 URL 若缺省會自動補上）
DATABASE_URL=postgresql://fitbuddy:password@localhost:5432/fitbuddy_dev
# [可選] 如果數據庫密碼單獨存儲
DATABASE_PASSWORD=your_db_password_here

# ========== Google OAuth 配置 ==========
# [必需] Google OAuth Client ID（前端和後端都需要，但用途不同）
# 前端：用於 Google 登入按鈕
# 後端：用於驗證 OAuth token
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# [必需] Google OAuth Client Secret（僅後端需要）
GOOGLE_CLIENT_SECRET=your_google_client_secret
# [必需] Google OAuth 回調 URL
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ========== JWT 配置 ==========
# [必需] JWT 簽名密鑰（用於生成 access token）
JWT_SECRET=your_jwt_secret_here
# [必需] Refresh Token 密鑰（用於生成 refresh token）
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
# [可選] Access Token 過期時間（默認: 7d）
ACCESS_TOKEN_EXPIRATION=7d
# [可選] Refresh Token 過期時間（默認: 30d）
REFRESH_TOKEN_EXPIRATION=30d

# ========== Session 配置 ==========
# [必需] Session 加密密鑰
SESSION_SECRET=your_session_secret_here

# ========== CORS 配置 ==========
# [可選] CORS 允許的來源（默認: http://localhost:5173）
CORS_ORIGIN=http://localhost:5173

# ========== 郵件服務配置 ==========
# 
# 選項 1: SendGrid (推薦，生產環境使用)
# [可選] SendGrid API Key
SENDGRID_API_KEY=your_sendgrid_api_key_here
# [可選] 發送郵件的來源地址
SENDGRID_FROM_EMAIL=noreply@fitbuddy.hk
# [可選] 回覆地址
SENDGRID_REPLY_TO=support@fitbuddy.hk
# [可選] 支持郵件地址
SENDGRID_SUPPORT_EMAIL=support@fitbuddy.hk
# [可選] SendGrid 模板 ID（如果使用模板）
SENDGRID_TEMPLATE_ID=your_template_id_here
#
# 選項 2: SMTP (開發環境，如 MailHog)
# [可選] SMTP 主機
SMTP_HOST=localhost
# [可選] SMTP 端口
SMTP_PORT=1025
# [可選] SMTP 用戶名
SMTP_USER=
# [可選] SMTP 密碼
SMTP_PASSWORD=

# ==========================================
# 前端環境變量（必須以 VITE_ 開頭）
# ==========================================
# 
# 注意：這些變量需要複製到 client/.env.local
# Vite 只會加載 client/ 目錄下的 .env 文件
#
# ========== 前端 API 配置 ==========
# [可選] API 伺服器基底 URL：
#   - 留空或設為相對路徑（如 /api）時，會使用當前頁面 origin（例：http://localhost:5173 的請求會打到同 origin 的 /api/...）
#   - 設為完整 URL（如 http://localhost:3000）時，所有 API 請求會發往該伺服器
# 開發時前後端同域可留空或 /api；前後端不同 port 時建議設為 http://localhost:3000
VITE_API_BASE_URL=

# ========== 前端 Google OAuth ==========
# [必需] Google OAuth Client ID（前端使用）
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# [可選] Google OAuth 回調 URL（前端使用）
VITE_GOOGLE_CALLBACK_URL=http://localhost:5173/auth/callback

# ========== 前端應用信息 ==========
# [可選] 應用名稱
VITE_APP_NAME=FitBuddy
# [可選] 應用版本
VITE_APP_VERSION=1.0.0

# ==========================================
# 開發環境默認值（僅用於開發，生產環境必須設置）
# ==========================================
# 
# 如果以下變量未設置，開發環境會使用默認值（不安全，僅用於開發）：
# - JWT_SECRET: 'dev-jwt-secret-key'
# - REFRESH_TOKEN_SECRET: 'dev-refresh-token-secret-key'
# - SESSION_SECRET: 'dev-session-secret'
#
# 生產環境必須設置所有 [必需] 標記的變量，否則應用會拒絕啟動。
