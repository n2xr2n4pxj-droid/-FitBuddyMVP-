// FitBuddy - 完整數據庫架構
// 支援：角色系統、教練-客戶關聯、TDEE、飲食、訓練追蹤

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 用戶與角色系統
// ==========================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  
  // 角色系統 - 核心功能
  role          Role     @default(USER)
  
  // 個人資料
  firstName     String?
  lastName      String?
  avatar        String?
  phone         String?
  dateOfBirth   DateTime?
  emailVerified Boolean  @default(false)
  
  // TDEE 相關欄位
  age           Int?
  gender        Gender?
  height        Float?   // cm
  weight        Float?   // kg
  bodyFat       Float?   // %
  activityLevel ActivityLevel?
  goal          GoalType?
  
  // 計算結果（自動更新）
  bmr           Float?   // 基礎代謝率
  tdee          Float?   // 總能量消耗
  bmi           Float?   // 身體質量指數
  goalCalories  Float?   // 目標卡路里
  goalProtein   Float?   // 目標蛋白質 (g)
  goalCarbs     Float?   // 目標碳水 (g)
  goalFat       Float?   // 目標脂肪 (g)
  
  // 時間戳
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActive    DateTime @default(now())
  
  // 關聯關係
  sentInvitations       Invitation[] @relation("InvitationSender")
  receivedInvitations   Invitation[] @relation("InvitationReceiver")
  
  // 教練端關聯（當我是教練時，我的客戶）
  myClients             CoachClientRelationship[] @relation("Coach")
  
  // 客戶端關聯（當我是客戶時，我的教練）
  myCoaches             CoachClientRelationship[] @relation("Client")
  
  // 個人數據
  meals                 Meal[]
  workouts              Workout[]
  progressEntries       ProgressEntry[]
  activityTimeline      ActivityLog[]
  
  // 朋友系統（Phase 3）
  sentFriendRequests    FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendships1          Friendship[] @relation("Friend1")
  friendships2          Friendship[] @relation("Friend2")
  
  @@index([email])
  @@index([username])
  @@index([role])
}

// 角色枚舉
enum Role {
  USER      // 普通用戶（客戶/運動員）
  COACH     // 教練
  BOTH      // 同時擁有兩種角色
  ADMIN     // 管理員（可選）
}

// 性別枚舉
enum Gender {
  MALE
  FEMALE
  OTHER
}

// 活動係數枚舉
enum ActivityLevel {
  SEDENTARY       // 1.2 - 久坐不動（辦公室工作，幾乎不運動）
  LIGHT           // 1.375 - 輕度活動（每週 1-3 天輕度運動）
  MODERATE        // 1.55 - 中度活動（每週 3-5 天中等強度運動）
  ACTIVE          // 1.725 - 高度活動（每週 6-7 天高強度運動）
  VERY_ACTIVE     // 1.9 - 極高活動（每天高強度訓練，體力勞動工作）
}

// 目標類型枚舉
enum GoalType {
  BULK            // 增肌 (+300-500 卡)
  CUT             // 減脂 (-300-500 卡)
  MAINTAIN        // 維持體重 (= TDEE)
  RAPID_CUT       // 極速減脂 (-500-1000 卡)
  CUSTOM          // 自定義目標
}

// ==========================================
// 邀請系統
// ==========================================

model Invitation {
  id            String   @id @default(uuid())
  
  // 邀請碼（唯一識別）
  code          String   @unique @default(cuid())
  
  // 發送者與接收者
  senderId      String
  sender        User     @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId    String?
  receiver      User?    @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  
  // 接收者識別（郵箱或用戶名，邀請尚未接受時使用）
  receiverEmail    String?
  receiverUsername String?
  
  // 邀請類型（教練邀請客戶 或 客戶邀請教練）
  invitationType InvitationType
  
  // 狀態管理
  status        InvitationStatus @default(PENDING)
  
  // 備註信息
  message       String?  @db.Text
  
  // 過期時間（預設 7 天）
  expiresAt     DateTime
  
  // 時間戳
  createdAt     DateTime @default(now())
  acceptedAt    DateTime?
  
  @@index([code])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([expiresAt])
}

// 邀請類型
enum InvitationType {
  COACH_TO_CLIENT    // 教練邀請客戶
  CLIENT_TO_COACH    // 客戶邀請教練
}

// 邀請狀態枚舉
enum InvitationStatus {
  PENDING     // 待處理
  ACCEPTED    // 已接受
  REJECTED    // 已拒絕
  EXPIRED     // 已過期
  CANCELLED   // 已取消
}

// ==========================================
// 教練-客戶關聯系統
// ==========================================

model CoachClientRelationship {
  id          String   @id @default(uuid())
  
  // 教練與客戶
  coachId     String
  coach       User     @relation("Coach", fields: [coachId], references: [id], onDelete: Cascade)
  
  clientId    String
  client      User     @relation("Client", fields: [clientId], references: [id], onDelete: Cascade)
  
  // 關係狀態
  status      RelationshipStatus @default(ACTIVE)
  
  // 權限設定（教練能看到哪些客戶數據）
  canViewMeals      Boolean @default(true)
  canViewWorkouts   Boolean @default(true)
  canViewProgress   Boolean @default(true)
  canEditTDEE       Boolean @default(true)
  canSendMessages   Boolean @default(true)
  
  // 備註（教練對客戶的筆記）
  coachNotes  String?  @db.Text
  
  // 時間戳
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  terminatedAt DateTime?
  
  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
  @@index([status])
}

// 關係狀態枚舉
enum RelationshipStatus {
  ACTIVE      // 活躍
  INACTIVE    // 不活躍（暫時停止）
  TERMINATED  // 已終止
}

// ==========================================
// 飲食追蹤系統
// ==========================================

model Meal {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 餐食資料
  name        String
  description String?  @db.Text
  mealType    MealType // 早餐、午餐、晚餐、點心
  
  // 營養數據
  calories    Float
  protein     Float    // g
  carbs       Float    // g
  fat         Float    // g
  
  // 額外數據（可選）
  fiber       Float?   // g
  sugar       Float?   // g
  sodium      Float?   // mg
  
  // 份量
  servingSize String?
  servings    Float?   @default(1)
  
  // 圖片
  imageUrl    String?
  
  // 時間戳
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([date])
  @@index([mealType])
}

// 餐食類型
enum MealType {
  BREAKFAST   // 早餐
  LUNCH       // 午餐
  DINNER      // 晚餐
  SNACK       // 點心
}

// ==========================================
// 訓練追蹤系統
// ==========================================

model Workout {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 訓練資料
  name        String
  description String?  @db.Text
  workoutType WorkoutType
  
  // 訓練數據
  duration    Int      // 分鐘
  caloriesBurned Float?
  intensity   Intensity?
  
  // 訓練細節
  exercises   Exercise[]
  
  // 備註
  notes       String?  @db.Text
  
  // 時間戳
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([date])
  @@index([workoutType])
}

// 訓練類型
enum WorkoutType {
  STRENGTH      // 力量訓練
  CARDIO        // 有氧運動
  FLEXIBILITY   // 柔韌性訓練
  SPORTS        // 運動項目
  OTHER         // 其他
}

// 強度
enum Intensity {
  LOW           // 低強度
  MODERATE      // 中等強度
  HIGH          // 高強度
  EXTREME       // 極高強度
}

// 單個運動項目
model Exercise {
  id          String   @id @default(uuid())
  
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  
  // 運動詳情
  name        String
  sets        Int?
  reps        Int?
  weight      Float?   // kg
  duration    Int?     // 秒
  distance    Float?   // km
  
  // 備註
  notes       String?  @db.Text
  
  // 排序
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  
  @@index([workoutId])
}

// ==========================================
// 進度追蹤系統
// ==========================================

model ProgressEntry {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 身體數據
  weight      Float    // kg
  bodyFat     Float?   // %
  muscleMass  Float?   // kg
  
  // 身體圍度（可選）
  chest       Float?   // cm
  waist       Float?   // cm
  hips        Float?   // cm
  arms        Float?   // cm
  thighs      Float?   // cm
  
  // 圖片
  photos      String[] // 照片 URLs
  
  // 備註
  notes       String?  @db.Text
  
  // 時間戳
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([date])
}

// ==========================================
// 活動日誌系統（教練查看客戶活動）
// ==========================================

model ActivityLog {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 活動類型
  activityType ActivityType
  
  // 活動描述
  description String   @db.Text
  
  // 關聯 ID（例如：meal_id, workout_id）
  relatedId   String?
  relatedType String?
  
  // 元數據（JSON 格式，存儲額外資料）
  metadata    Json?
  
  // 時間戳
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
}

// 活動類型
enum ActivityType {
  MEAL_LOGGED         // 記錄餐食
  WORKOUT_LOGGED      // 記錄訓練
  PROGRESS_UPDATED    // 更新進度
  TDEE_UPDATED        // 更新 TDEE
  WEIGHT_UPDATED      // 更新體重
  GOAL_CHANGED        // 目標變更
  COACH_ADDED         // 添加教練
  CLIENT_ADDED        // 添加客戶
  RELATIONSHIP_ENDED  // 關係終止
}

// ==========================================
// 朋友系統（Phase 3）
// ==========================================

model FriendRequest {
  id          String   @id @default(uuid())
  
  senderId    String
  sender      User     @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String
  receiver    User     @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  
  status      FriendRequestStatus @default(PENDING)
  
  message     String?  @db.Text
  
  createdAt   DateTime @default(now())
  respondedAt DateTime?
  
  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Friendship {
  id          String   @id @default(uuid())
  
  user1Id     String
  user1       User     @relation("Friend1", fields: [user1Id], references: [id], onDelete: Cascade)
  
  user2Id     String
  user2       User     @relation("Friend2", fields: [user2Id], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

